# Copy this file to .env (already gitignored) and fill in real values.
# Never commit .env. Never put a mainnet private key here.

# Polygon Amoy testnet RPC endpoint. This public default is rate-limited;
# swap in your own Alchemy/Infura Amoy endpoint if it's slow or flaky.
RPC_URL=https://rpc-amoy.polygon.technology

# Private key of the wallet used to send anchoring transactions.
# TESTNET ONLY — this wallet should hold nothing but free Amoy test POL.
# Generate a fresh throwaway one with: npm run generate-wallet
PRIVATE_KEY=0xyour_testnet_private_key_here
